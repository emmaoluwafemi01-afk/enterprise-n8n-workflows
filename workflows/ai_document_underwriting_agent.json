    {
      "parameters": {
        "jsCode": "// Production Data Preprocessing & Chunking\nconst rawData = $input.first().json.body;\nconst rawText = rawData.document_text || \"\";\n\n// Basic text cleaning & normalization\nconst cleanedText = rawText.replace(/\\s+/g, ' ').trim();\n\n// Chunking logic (500 chars per chunk with 50 char overlap)\nconst chunkSize = 500;\nconst overlap = 50;\nconst chunks = [];\n\nfor (let i = 0; i < cleanedText.length; i += (chunkSize - overlap)) {\n  chunks.push({\n    chunk_id: chunks.length + 1,\n    text: cleanedText.substring(i, i + chunkSize),\n    applicant_id: rawData.applicant_id || \"UNKNOWN_APP\"\n  });\n}\n\nreturn chunks.map(chunk => ({ json: chunk }));"
      },
      "id": "2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "Code Node: Text Ingestion & Chunking",
